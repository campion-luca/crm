# Supabase: Project Settings → API Keys (chiave "Publishable") e Data API (Project URL)
# Lasciale vuote per usare la modalità locale (dati salvati nel browser, nessun login).
# La chiave "Secret" NON va mai qui: finirebbe nel codice pubblicato.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
